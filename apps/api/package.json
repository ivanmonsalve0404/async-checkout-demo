{
  "name": "@checkout/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:coverage": "node ../../scripts/evidence/run-jest-coverage.mjs api",
    "test:contract": "jest --config jest.config.cjs --runInBand --testPathPatterns=contract",
    "seed": "tsx src/infrastructure/persistence/seed.cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1111.0",
    "@aws-sdk/lib-dynamodb": "3.1111.0",
    "@checkout/contracts": "workspace:*",
    "@codegenie/serverless-express": "5.0.0",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.1",
    "@types/aws-lambda": "8.10.162",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.1",
    "jest": "30.4.2",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12"
  }
}

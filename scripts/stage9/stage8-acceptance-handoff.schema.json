{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checkout.example.invalid/schemas/stage8-acceptance-handoff.schema.json",
  "title": "Accepted Stage 8 handoff to Stage 9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "stage",
    "kind",
    "status",
    "acceptanceId",
    "generatedAtUtc",
    "decision",
    "release",
    "gates",
    "urls",
    "report",
    "package",
    "scorecard",
    "quality",
    "delivery",
    "acceptance",
    "operation",
    "finalization",
    "containsSensitiveData",
    "handoffSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "schemaId": { "const": "async-checkout-stage8-acceptance-handoff" },
    "stage": { "const": 8 },
    "kind": { "const": "STAGE8_HANDOFF_TO_STAGE9" },
    "status": { "const": "READY_FOR_STAGE9" },
    "acceptanceId": {
      "type": "string",
      "pattern": "^acc-[a-z0-9][a-z0-9._-]{7,95}$"
    },
    "generatedAtUtc": { "$ref": "#/$defs/utc" },
    "decision": { "const": "ACCEPTED" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "runtimeSha", "submissionSha", "tag", "documentationCommit"],
      "properties": {
        "releaseId": {
          "type": "string",
          "pattern": "^rel-[0-9]{8}-[0-9]{4}-[0-9a-f]{7}$"
        },
        "runtimeSha": { "$ref": "#/$defs/sha" },
        "submissionSha": { "$ref": "#/$defs/sha" },
        "documentationCommit": { "$ref": "#/$defs/documentationCommit" },
        "tag": { "type": "string" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["GATE-E8-01", "GATE-E8-02", "GATE-E8-03"],
      "properties": {
        "GATE-E8-01": { "const": "PASS" },
        "GATE-E8-02": { "const": "PASS" },
        "GATE-E8-03": { "const": "PASS" }
      }
    },
    "urls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "api", "docs", "health", "repository"],
      "properties": {
        "application": { "$ref": "#/$defs/httpsUrl" },
        "api": { "$ref": "#/$defs/httpsUrl" },
        "docs": { "$ref": "#/$defs/httpsUrl" },
        "health": { "$ref": "#/$defs/httpsUrl" },
        "repository": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "rawSha256"],
      "properties": {
        "filename": { "const": "etapa-8-aceptacion-evaluacion-final.md" },
        "rawSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawSha256",
        "indexRawSha256",
        "evidenceInventorySha256",
        "artifactBindingsSha256",
        "artifacts",
        "evidence",
        "cases",
        "auditControls"
      ],
      "properties": {
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "indexRawSha256": { "$ref": "#/$defs/sha256" },
        "evidenceInventorySha256": { "$ref": "#/$defs/sha256" },
        "artifactBindingsSha256": { "$ref": "#/$defs/sha256" },
        "artifacts": { "const": 16 },
        "evidence": { "const": 48 },
        "cases": { "const": 32 },
        "auditControls": { "const": 72 }
      }
    },
    "scorecard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseVerifiedPoints",
        "baseTotalPoints",
        "bonusVerifiedPoints",
        "bonusTotalPoints",
        "highConfidenceBaseRubrics"
      ],
      "properties": {
        "baseVerifiedPoints": { "const": 100 },
        "baseTotalPoints": { "const": 100 },
        "bonusVerifiedPoints": { "type": "integer", "minimum": 0, "maximum": 50 },
        "bonusTotalPoints": { "const": 50 },
        "highConfidenceBaseRubrics": { "const": 6 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openP0",
        "openP1",
        "openP2",
        "acceptedP2",
        "disqualifiers",
        "openCriticalRisks"
      ],
      "properties": {
        "openP0": { "const": 0 },
        "openP1": { "const": 0 },
        "openP2": { "type": "integer", "minimum": 0 },
        "acceptedP2": { "type": "integer", "minimum": 0 },
        "disqualifiers": { "const": 0 },
        "openCriticalRisks": { "const": 0 }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryPublic", "readmeFinal"],
      "properties": {
        "repositoryPublic": { "const": true },
        "readmeFinal": { "const": true }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defectsAccepted", "risksAccepted", "deviationsAccepted"],
      "properties": {
        "defectsAccepted": { "const": true },
        "risksAccepted": { "const": true },
        "deviationsAccepted": { "const": true }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expiresAtUtc",
        "ownerAlias",
        "dashboardUrl",
        "alarmsStatus",
        "budget",
        "rollbackRunbook",
        "cleanupRunbook",
        "evidenceRetention",
        "pendingTransactions",
        "incident",
        "contacts",
        "closeWindow"
      ],
      "properties": {
        "expiresAtUtc": { "$ref": "#/$defs/utc" },
        "ownerAlias": { "type": "string" },
        "dashboardUrl": { "$ref": "#/$defs/httpsUrl" },
        "alarmsStatus": { "const": "READY" },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "amount", "asOfUtc"],
          "properties": {
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "amount": { "type": "number", "minimum": 0 },
            "asOfUtc": { "$ref": "#/$defs/utc" }
          }
        },
        "rollbackRunbook": { "$ref": "#/$defs/runbook" },
        "cleanupRunbook": { "$ref": "#/$defs/runbook" },
        "evidenceRetention": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policyId", "expiresAtUtc"],
          "properties": {
            "policyId": { "type": "string" },
            "expiresAtUtc": { "$ref": "#/$defs/utc" }
          }
        },
        "pendingTransactions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "count"],
          "properties": {
            "status": { "const": "INVENTORIED" },
            "count": { "type": "integer", "minimum": 0 }
          }
        },
        "incident": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "id"],
          "properties": {
            "status": { "enum": ["NONE", "OPEN"] },
            "id": { "type": ["string", "null"] }
          }
        },
        "contacts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "closeWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startsAtUtc", "endsAtUtc"],
          "properties": {
            "startsAtUtc": { "$ref": "#/$defs/utc" },
            "endsAtUtc": { "$ref": "#/$defs/utc" }
          }
        }
      }
    },
    "finalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draftRawSha256", "draftSha256", "authority"],
      "properties": {
        "draftRawSha256": { "$ref": "#/$defs/sha256" },
        "draftSha256": { "$ref": "#/$defs/sha256" },
        "authority": { "$ref": "#/$defs/finalizationAuthority" }
      }
    },
    "containsSensitiveData": { "const": false },
    "handoffSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "alias": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"
    },
    "documentationCommit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "authority"],
          "properties": {
            "mode": { "const": "SAME_COMMIT" },
            "authority": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "authority"],
          "properties": {
            "mode": { "const": "DOCUMENTATION_ONLY_APPROVED" },
            "authority": { "$ref": "#/$defs/documentationAuthority" }
          }
        }
      ]
    },
    "documentationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "stage",
        "kind",
        "status",
        "fromSha",
        "toSha",
        "changedPaths",
        "ownerAlias",
        "approvedByAlias",
        "approvedAtUtc",
        "reason",
        "sourceHashes",
        "containsSensitiveData",
        "authoritySha256",
        "authorityRawSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "stage": { "const": 8 },
        "kind": { "const": "STAGE8_DOCUMENTATION_COMMIT_AUTHORITY" },
        "status": { "const": "APPROVED" },
        "fromSha": { "$ref": "#/$defs/sha" },
        "toSha": { "$ref": "#/$defs/sha" },
        "changedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:README\\.md|docs/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+\\.md)$"
          }
        },
        "ownerAlias": { "$ref": "#/$defs/alias" },
        "approvedByAlias": { "$ref": "#/$defs/alias" },
        "approvedAtUtc": { "$ref": "#/$defs/utc" },
        "reason": { "type": "string", "minLength": 12, "maxLength": 500 },
        "sourceHashes": { "$ref": "#/$defs/documentationSourceHashes" },
        "containsSensitiveData": { "const": false },
        "authoritySha256": { "$ref": "#/$defs/sha256" },
        "authorityRawSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "documentationSourceHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitMetadataRawSha256",
        "changedPathsRawSha256",
        "approvalRawSha256",
        "updatedManifestRawSha256"
      ],
      "properties": {
        "commitMetadataRawSha256": { "$ref": "#/$defs/sha256" },
        "changedPathsRawSha256": { "$ref": "#/$defs/sha256" },
        "approvalRawSha256": { "$ref": "#/$defs/sha256" },
        "updatedManifestRawSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "finalizationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "stage",
        "kind",
        "status",
        "acceptanceId",
        "release",
        "provisionalSnapshotSha256",
        "sourceHashes",
        "assessmentSha256",
        "indexSha256",
        "packageSha256",
        "reportSha256",
        "handoffSha256",
        "evidenceInventorySha256",
        "artifactBindingsSha256",
        "artifactInventory",
        "artifactInventorySha256",
        "ownerAlias",
        "approvedByAlias",
        "approvedAtUtc",
        "reason",
        "containsSensitiveData",
        "authoritySha256",
        "authorityRawSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "stage": { "const": 8 },
        "kind": { "const": "STAGE8_ACCEPTANCE_FINALIZATION_AUTHORITY" },
        "status": { "const": "APPROVED" },
        "acceptanceId": {
          "type": "string",
          "pattern": "^acc-[a-z0-9][a-z0-9._-]{7,95}$"
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["releaseId", "runtimeSha", "submissionSha", "tag", "documentationCommit"],
          "properties": {
            "releaseId": {
              "type": "string",
              "pattern": "^rel-[0-9]{8}-[0-9]{4}-[0-9a-f]{7}$"
            },
            "runtimeSha": { "$ref": "#/$defs/sha" },
            "submissionSha": { "$ref": "#/$defs/sha" },
            "tag": { "type": "string" },
            "documentationCommit": { "$ref": "#/$defs/documentationCommit" }
          }
        },
        "provisionalSnapshotSha256": { "$ref": "#/$defs/sha256" },
        "sourceHashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assessmentRawSha256",
            "indexRawSha256",
            "packageRawSha256",
            "reportRawSha256",
            "handoffRawSha256"
          ],
          "properties": {
            "assessmentRawSha256": { "$ref": "#/$defs/sha256" },
            "indexRawSha256": { "$ref": "#/$defs/sha256" },
            "packageRawSha256": { "$ref": "#/$defs/sha256" },
            "reportRawSha256": { "$ref": "#/$defs/sha256" },
            "handoffRawSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "assessmentSha256": { "$ref": "#/$defs/sha256" },
        "indexSha256": { "$ref": "#/$defs/sha256" },
        "packageSha256": { "$ref": "#/$defs/sha256" },
        "reportSha256": { "$ref": "#/$defs/sha256" },
        "handoffSha256": { "$ref": "#/$defs/sha256" },
        "evidenceInventorySha256": { "$ref": "#/$defs/sha256" },
        "artifactBindingsSha256": { "$ref": "#/$defs/sha256" },
        "artifactInventory": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/artifactInventoryEntry" }
        },
        "artifactInventorySha256": { "$ref": "#/$defs/sha256" },
        "ownerAlias": { "$ref": "#/$defs/alias" },
        "approvedByAlias": { "$ref": "#/$defs/alias" },
        "approvedAtUtc": { "$ref": "#/$defs/utc" },
        "reason": { "type": "string", "minLength": 12, "maxLength": 500 },
        "containsSensitiveData": { "const": false },
        "authoritySha256": { "$ref": "#/$defs/sha256" },
        "authorityRawSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactInventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "material", "evidenceIds", "sources"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ART-ACC-(?:0[1-9]|1[0-6])$"
        },
        "material": { "enum": ["EVIDENCE_SET", "ASSESSMENT", "HANDOFF", "EVIDENCE_INDEX"] },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 48,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVD-E8-(?:0[1-9]|[1-3][0-9]|4[0-8])$"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 49,
          "items": { "$ref": "#/$defs/materialSource" }
        }
      }
    },
    "materialSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rawSha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "runbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://async-checkout.invalid/schemas/stage6-external-evidence-v1.json",
  "title": "Stage 6 authorized external evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "stage",
    "protocolVersion",
    "protocolDocumentSha256",
    "commitSha",
    "runId",
    "executedAtUtc",
    "reviewerAlias",
    "capabilities",
    "containsSensitiveData"
  ],
  "properties": {
    "schemaId": { "const": "async-checkout-stage6-external-evidence" },
    "schemaVersion": { "const": 1 },
    "stage": { "const": 6 },
    "protocolVersion": { "const": "1.0.0" },
    "protocolDocumentSha256": { "$ref": "#/$defs/sha256" },
    "commitSha": { "$ref": "#/$defs/commitSha" },
    "runId": { "$ref": "#/$defs/runId" },
    "executedAtUtc": { "$ref": "#/$defs/utc" },
    "reviewerAlias": { "$ref": "#/$defs/alias" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ownedTarget": { "$ref": "#/$defs/ownedTarget" },
        "sandboxSmoke": { "$ref": "#/$defs/sandboxSmoke" },
        "passiveSecurity": { "$ref": "#/$defs/passiveSecurity" }
      }
    },
    "containsSensitiveData": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runId": {
      "type": "string",
      "pattern": "^e6-[0-9]{8}t[0-9]{6}z-[0-9a-f]{8}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "alias": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$" },
    "safeVersion": {
      "type": "string",
      "enum": ["2.16.1"]
    },
    "auth01": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "scope",
        "approvalSha256",
        "approvedTargetSha256",
        "approvedAtUtc",
        "expiresAtUtc",
        "ownerAlias",
        "maxRequests"
      ],
      "properties": {
        "id": { "const": "AUTH-E6-01" },
        "status": { "const": "APPROVED" },
        "scope": { "const": "OWNED_EPHEMERAL_QA_HTTPS_VERIFICATION" },
        "approvalSha256": { "$ref": "#/$defs/sha256" },
        "approvedTargetSha256": { "$ref": "#/$defs/sha256" },
        "approvedAtUtc": { "$ref": "#/$defs/utc" },
        "expiresAtUtc": { "$ref": "#/$defs/utc" },
        "ownerAlias": { "$ref": "#/$defs/alias" },
        "maxRequests": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "auth02": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "scope",
        "approvalSha256",
        "approvedTargetSha256",
        "approvedAtUtc",
        "expiresAtUtc",
        "ownerAlias",
        "maxRequests"
      ],
      "properties": {
        "id": { "const": "AUTH-E6-02" },
        "status": { "const": "APPROVED" },
        "scope": { "const": "AUTHORIZED_PROVIDER_SANDBOX_SMOKE" },
        "approvalSha256": { "$ref": "#/$defs/sha256" },
        "approvedTargetSha256": { "$ref": "#/$defs/sha256" },
        "approvedAtUtc": { "$ref": "#/$defs/utc" },
        "expiresAtUtc": { "$ref": "#/$defs/utc" },
        "ownerAlias": { "$ref": "#/$defs/alias" },
        "maxRequests": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "auth03": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "scope",
        "approvalSha256",
        "approvedTargetSha256",
        "approvedAtUtc",
        "expiresAtUtc",
        "ownerAlias",
        "maxRequests"
      ],
      "properties": {
        "id": { "const": "AUTH-E6-03" },
        "status": { "const": "APPROVED" },
        "scope": { "const": "PASSIVE_BASELINE_OWNED_QA_ONLY" },
        "approvalSha256": { "$ref": "#/$defs/sha256" },
        "approvedTargetSha256": { "$ref": "#/$defs/sha256" },
        "approvedAtUtc": { "$ref": "#/$defs/utc" },
        "expiresAtUtc": { "$ref": "#/$defs/utc" },
        "ownerAlias": { "$ref": "#/$defs/alias" },
        "maxRequests": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "qaTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "environment",
        "originSha256",
        "ownershipVerified",
        "production"
      ],
      "properties": {
        "classification": { "const": "OWNED_EPHEMERAL_QA" },
        "environment": { "const": "ENV-E6-QA" },
        "originSha256": { "$ref": "#/$defs/sha256" },
        "ownershipVerified": { "const": true },
        "production": { "const": false }
      }
    },
    "sandboxTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "environment",
        "hostSha256",
        "allowlistVerified",
        "production"
      ],
      "properties": {
        "classification": { "const": "AUTHORIZED_PROVIDER_SANDBOX" },
        "environment": { "const": "sandbox" },
        "hostSha256": { "$ref": "#/$defs/sha256" },
        "allowlistVerified": { "const": true },
        "production": { "const": false }
      }
    },
    "ownedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "authorization",
        "target",
        "checks",
        "requests",
        "evidenceIds",
        "reportSha256"
      ],
      "properties": {
        "status": { "const": "PASS" },
        "authorization": { "$ref": "#/$defs/auth01" },
        "target": { "$ref": "#/$defs/qaTarget" },
        "checks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "status", "observedStatus"],
              "properties": {
                "id": { "const": "AUTH01-E6-01" },
                "name": { "const": "http-redirect-to-https" },
                "status": { "const": "PASS" },
                "observedStatus": { "enum": [301, 308] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "status", "observedStatus"],
              "properties": {
                "id": { "const": "AUTH01-E6-02" },
                "name": { "const": "https-document-available" },
                "status": { "const": "PASS" },
                "observedStatus": { "const": 200 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "status", "observedRequests"],
              "properties": {
                "id": { "const": "AUTH01-E6-03" },
                "name": { "const": "mixed-content-requests-zero" },
                "status": { "const": "PASS" },
                "observedRequests": { "const": 0 }
              }
            }
          ],
          "items": false
        },
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "outsideAllowlist", "provider", "production"],
          "properties": {
            "total": { "type": "integer", "minimum": 1, "maximum": 100 },
            "outsideAllowlist": { "const": 0 },
            "provider": { "const": 0 },
            "production": { "const": 0 }
          }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "AUTH-E6-01" },
            { "const": "UAT-33" },
            { "const": "EVD-E6-36/UAT-33" }
          ],
          "items": false
        },
        "reportSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sandboxSmoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "authorization",
        "target",
        "reference",
        "checks",
        "requests",
        "result",
        "evidenceIds",
        "reportSha256"
      ],
      "properties": {
        "status": { "const": "PASS" },
        "authorization": { "$ref": "#/$defs/auth02" },
        "target": { "$ref": "#/$defs/sandboxTarget" },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prefix", "sha256", "runScoped", "rawValueCaptured"],
          "properties": {
            "prefix": { "const": "e6-" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "runScoped": { "const": true },
            "rawValueCaptured": { "const": false }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            { "$ref": "#/$defs/sandboxCheck01" },
            { "$ref": "#/$defs/sandboxCheck02" },
            { "$ref": "#/$defs/sandboxCheck03" },
            { "$ref": "#/$defs/sandboxCheck04" },
            { "$ref": "#/$defs/sandboxCheck05" },
            { "$ref": "#/$defs/sandboxCheck06" },
            { "$ref": "#/$defs/sandboxCheck07" },
            { "$ref": "#/$defs/sandboxCheck08" }
          ],
          "items": false
        },
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "configurationReads",
            "paymentMethodCreations",
            "transactionCreates",
            "statusReads",
            "errorMappingProbes",
            "reconciliationReplays",
            "production",
            "globalMutations",
            "outsideAllowlist"
          ],
          "properties": {
            "total": { "type": "integer", "minimum": 1, "maximum": 100 },
            "configurationReads": { "type": "integer", "minimum": 1, "maximum": 100 },
            "paymentMethodCreations": { "const": 1 },
            "transactionCreates": { "const": 1 },
            "statusReads": { "type": "integer", "minimum": 1, "maximum": 100 },
            "errorMappingProbes": { "type": "integer", "minimum": 1, "maximum": 100 },
            "reconciliationReplays": { "type": "integer", "minimum": 1, "maximum": 100 },
            "production": { "const": 0 },
            "globalMutations": { "const": 0 },
            "outsideAllowlist": { "const": 0 }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "providerState",
            "localState",
            "amountMatches",
            "currencyMatches",
            "referenceMatches",
            "reconciliationConsistent",
            "duplicateEffects",
            "adapterDisabledByConfiguration"
          ],
          "properties": {
            "providerState": { "enum": ["APPROVED", "DECLINED", "ERROR", "PENDING"] },
            "localState": { "enum": ["APPROVED", "DECLINED", "ERROR", "PENDING"] },
            "amountMatches": { "const": true },
            "currencyMatches": { "const": true },
            "referenceMatches": { "const": true },
            "reconciliationConsistent": { "const": true },
            "duplicateEffects": { "const": 0 },
            "adapterDisabledByConfiguration": { "const": true }
          }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "AUTH-E6-02" },
            { "const": "EVD-E6-24" },
            { "const": "ART-VER-07" }
          ],
          "items": false
        },
        "reportSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sandboxCheck01": {
      "$ref": "#/$defs/passCheck01"
    },
    "sandboxCheck02": {
      "$ref": "#/$defs/passCheck02"
    },
    "sandboxCheck03": {
      "$ref": "#/$defs/passCheck03"
    },
    "sandboxCheck04": {
      "$ref": "#/$defs/passCheck04"
    },
    "sandboxCheck05": {
      "$ref": "#/$defs/passCheck05"
    },
    "sandboxCheck06": {
      "$ref": "#/$defs/passCheck06"
    },
    "sandboxCheck07": {
      "$ref": "#/$defs/passCheck07"
    },
    "sandboxCheck08": {
      "$ref": "#/$defs/passCheck08"
    },
    "passCheck01": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "const": "AUTH02-E6-01" },
        "name": { "const": "acceptance-configuration-observed" },
        "status": { "const": "PASS" }
      }
    },
    "passCheck02": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "const": "AUTH02-E6-02" },
        "name": { "const": "authorized-test-payment-method-created" },
        "status": { "const": "PASS" }
      }
    },
    "passCheck03": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "const": "AUTH02-E6-03" },
        "name": { "const": "local-pending-created-first" },
        "status": { "const": "PASS" }
      }
    },
    "passCheck04": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "const": "AUTH02-E6-04" },
        "name": { "const": "provider-sandbox-transaction-created" },
        "status": { "const": "PASS" }
      }
    },
    "passCheck05": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "const": "AUTH02-E6-05" },
        "name": { "const": "provider-status-polled" },
        "status": { "const": "PASS" }
      }
    },
    "passCheck06": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "const": "AUTH02-E6-06" },
        "name": { "const": "amount-currency-reference-validated" },
        "status": { "const": "PASS" }
      }
    },
    "passCheck07": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "const": "AUTH02-E6-07" },
        "name": { "const": "provider-errors-redacted" },
        "status": { "const": "PASS" }
      }
    },
    "passCheck08": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "const": "AUTH02-E6-08" },
        "name": { "const": "reconciliation-replay-idempotent" },
        "status": { "const": "PASS" }
      }
    },
    "headerCheck01": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "const": "AUTH03-E6-HDR-01" },
        "name": { "const": "content-security-policy" },
        "status": { "const": "PASS" }
      }
    },
    "headerCheck02": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "const": "AUTH03-E6-HDR-02" },
        "name": { "const": "referrer-policy" },
        "status": { "const": "PASS" }
      }
    },
    "headerCheck03": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "const": "AUTH03-E6-HDR-03" },
        "name": { "const": "x-content-type-options" },
        "status": { "const": "PASS" }
      }
    },
    "headerCheck04": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "const": "AUTH03-E6-HDR-04" },
        "name": { "const": "clickjacking-protection" },
        "status": { "const": "PASS" }
      }
    },
    "headerCheck05": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "const": "AUTH03-E6-HDR-05" },
        "name": { "const": "permissions-policy" },
        "status": { "const": "PASS" }
      }
    },
    "headerCheck06": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "const": "AUTH03-E6-HDR-06" },
        "name": { "const": "strict-transport-security" },
        "status": { "const": "PASS" }
      }
    },
    "passiveSecurity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "authorization",
        "target",
        "headerChecks",
        "sensitiveResponsesNoStore",
        "criticalHeadersMissing",
        "zap",
        "requests",
        "evidenceIds"
      ],
      "properties": {
        "status": { "const": "PASS" },
        "authorization": { "$ref": "#/$defs/auth03" },
        "target": { "$ref": "#/$defs/qaTarget" },
        "headerChecks": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            { "$ref": "#/$defs/headerCheck01" },
            { "$ref": "#/$defs/headerCheck02" },
            { "$ref": "#/$defs/headerCheck03" },
            { "$ref": "#/$defs/headerCheck04" },
            { "$ref": "#/$defs/headerCheck05" },
            { "$ref": "#/$defs/headerCheck06" }
          ],
          "items": false
        },
        "sensitiveResponsesNoStore": { "const": true },
        "criticalHeadersMissing": { "const": 0 },
        "zap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "tool",
            "rulesetSha256",
            "reportSha256",
            "ownEndpointsScanned",
            "ownEndpointsOutOfScope",
            "findings",
            "manualValidation"
          ],
          "properties": {
            "mode": { "const": "PASSIVE_BASELINE" },
            "tool": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version"],
              "properties": {
                "name": { "const": "OWASP_ZAP_BASELINE" },
                "version": { "$ref": "#/$defs/safeVersion" }
              }
            },
            "rulesetSha256": { "$ref": "#/$defs/sha256" },
            "reportSha256": { "$ref": "#/$defs/sha256" },
            "ownEndpointsScanned": { "type": "integer", "minimum": 1, "maximum": 100 },
            "ownEndpointsOutOfScope": { "const": 0 },
            "findings": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "total",
                "reviewed",
                "critical",
                "high",
                "medium",
                "low",
                "informational"
              ],
              "properties": {
                "total": { "type": "integer", "minimum": 0, "maximum": 100 },
                "reviewed": { "type": "integer", "minimum": 0, "maximum": 100 },
                "critical": { "const": 0 },
                "high": { "const": 0 },
                "medium": { "type": "integer", "minimum": 0, "maximum": 100 },
                "low": { "type": "integer", "minimum": 0, "maximum": 100 },
                "informational": { "type": "integer", "minimum": 0, "maximum": 100 }
              }
            },
            "manualValidation": { "const": "ALL_ALERTS_REVIEWED" }
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "outsideAllowlist",
            "provider",
            "production",
            "externalRedirectsFollowed",
            "activeScan"
          ],
          "properties": {
            "total": { "type": "integer", "minimum": 1, "maximum": 100 },
            "outsideAllowlist": { "const": 0 },
            "provider": { "const": 0 },
            "production": { "const": 0 },
            "externalRedirectsFollowed": { "const": 0 },
            "activeScan": { "const": 0 }
          }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "AUTH-E6-03" },
            { "const": "EVD-E6-33" },
            { "const": "EVD-E6-34" }
          ],
          "items": false
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://async-checkout.invalid/schemas/stage7-sandbox-execution-request-v1.json",
  "title": "Stage 7 sandbox execution approval request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "stage",
    "kind",
    "status",
    "scope",
    "repository",
    "workflow",
    "execution",
    "limits",
    "requestedAtUtc",
    "expiresAtUtc",
    "requestId",
    "containsSensitiveData"
  ],
  "properties": {
    "schemaId": { "const": "async-checkout-stage7-sandbox-execution-request" },
    "schemaVersion": { "const": 1 },
    "stage": { "const": 7 },
    "kind": { "const": "SANDBOX_ONE_USE_EXECUTION_REQUEST" },
    "status": { "const": "AWAITING_PROTECTED_APPROVAL" },
    "scope": { "enum": ["full", "prerelease"] },
    "repository": { "const": "ivanmonsalve0404/async-checkout-demo" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "ref", "sha", "producerJob", "targetJob"],
      "properties": {
        "file": {
          "enum": [".github/workflows/release.yml", ".github/workflows/prerelease.yml"]
        },
        "ref": {
          "type": "string",
          "pattern": "^ivanmonsalve0404/async-checkout-demo/\\.github/workflows/(?:release|prerelease)\\.yml@refs/heads/master$"
        },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "producerJob": { "enum": ["quality", "deploy-prerelease"] },
        "targetJob": { "enum": ["sandbox-smoke", "external-verification"] }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "runAttempt",
        "environment",
        "candidateSha",
        "releaseId",
        "releaseTag",
        "configSha256",
        "rerunExplicitlyRequested",
        "rerunOfAttempt"
      ],
      "properties": {
        "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "runAttempt": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "environment": {
          "enum": ["assessment-release", "assessment-prerelease-external"]
        },
        "candidateSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "releaseId": {
          "type": "string",
          "pattern": "^rel-[0-9]{8}-[0-9]{4}-[0-9a-f]{7}$"
        },
        "releaseTag": {
          "type": "string",
          "pattern": "^(?:v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-rc\\.[1-9][0-9]*)?|NOT_APPLICABLE)$"
        },
        "configSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "rerunExplicitlyRequested": { "type": "boolean" },
        "rerunOfAttempt": { "type": "integer", "minimum": 0, "maximum": 999 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalRequests", "tokenizations", "transactions"],
      "properties": {
        "externalRequests": { "const": 8 },
        "tokenizations": { "const": 1 },
        "transactions": { "const": 1 }
      }
    },
    "requestedAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "expiresAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "requestId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "containsSensitiveData": { "const": false }
  }
}

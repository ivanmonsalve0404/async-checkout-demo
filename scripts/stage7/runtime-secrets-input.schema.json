{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checkout-assessment.invalid/schemas/stage7-runtime-secrets-input.schema.json",
  "title": "Stage 7 private runtime secrets input",
  "description": "Private operator input. Init leaves Sandbox fields null; the operator supplies only the three Sandbox credentials and hydrate obtains the four acceptance fields. Validate/materialize require all seven values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["accountId", "kind", "sandbox", "schemaVersion", "stage", "targets"],
  "properties": {
    "accountId": {
      "type": "string",
      "pattern": "^(?!0{12}$)[0-9]{12}$"
    },
    "kind": {
      "const": "STAGE7_RUNTIME_SECRETS_INPUT"
    },
    "sandbox": {
      "$ref": "#/$defs/sandbox"
    },
    "schemaVersion": {
      "const": 1
    },
    "stage": {
      "const": 7
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full", "prerelease"],
      "properties": {
        "full": {
          "$ref": "#/$defs/generatedValues"
        },
        "prerelease": {
          "$ref": "#/$defs/generatedValues"
        }
      }
    }
  },
  "$defs": {
    "acceptanceToken": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 8,
          "maxLength": 8192
        }
      ]
    },
    "canonicalBase64Url": {
      "type": "string",
      "minLength": 43,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "generatedValues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prereleaseOriginToken": {
          "$ref": "#/$defs/canonicalBase64Url"
        },
        "runtimeSecurityRootKey": {
          "$ref": "#/$defs/canonicalBase64Url"
        }
      }
    },
    "integritySecret": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^test_integrity_[A-Za-z0-9_-]{8,256}$"
        }
      ]
    },
    "permalink": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri"
        }
      ]
    },
    "privateKey": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^prv_test_[A-Za-z0-9_-]{8,256}$"
        }
      ]
    },
    "publicKey": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^pub_test_[A-Za-z0-9_-]{8,128}$"
        }
      ]
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integritySecret",
        "personalDataAcceptanceToken",
        "personalDataPermalink",
        "privateKey",
        "publicKey",
        "termsAcceptanceToken",
        "termsPermalink"
      ],
      "properties": {
        "integritySecret": {
          "$ref": "#/$defs/integritySecret"
        },
        "personalDataAcceptanceToken": {
          "$ref": "#/$defs/acceptanceToken"
        },
        "personalDataPermalink": {
          "$ref": "#/$defs/permalink"
        },
        "privateKey": {
          "$ref": "#/$defs/privateKey"
        },
        "publicKey": {
          "$ref": "#/$defs/publicKey"
        },
        "termsAcceptanceToken": {
          "$ref": "#/$defs/acceptanceToken"
        },
        "termsPermalink": {
          "$ref": "#/$defs/permalink"
        }
      }
    }
  }
}

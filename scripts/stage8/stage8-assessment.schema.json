{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checkout.example.invalid/schemas/stage8-assessment.schema.json",
  "title": "Executed Stage 8 assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stage",
    "kind",
    "acceptanceId",
    "release",
    "generatedAtUtc",
    "artifacts",
    "evidence",
    "cases",
    "auditControls",
    "gates",
    "scorecard",
    "quality",
    "demo",
    "package",
    "decision",
    "signatures",
    "handoffReady",
    "containsSensitiveData",
    "assessmentSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "stage": { "const": 8 },
    "kind": { "const": "STAGE8_EXECUTED_ASSESSMENT" },
    "acceptanceId": {
      "type": "string",
      "pattern": "^acc-[a-z0-9][a-z0-9._-]{7,95}$"
    },
    "release": { "$ref": "#/$defs/release" },
    "generatedAtUtc": {
      "oneOf": [{ "$ref": "#/$defs/utc" }, { "type": "null" }]
    },
    "artifacts": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^ART-ACC-(?:0[1-9]|1[0-6])$" },
          "status": {
            "enum": [
              "NOT_STARTED",
              "IN_PROGRESS",
              "VERIFIED",
              "FAILED",
              "BLOCKED_EXTERNAL",
              "CLOSED_OR_ACCEPTED",
              "REHEARSED",
              "READY",
              "ACCEPTED",
              "REJECTED",
              "NOT_APPLICABLE_APPROVED"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "sourcePath", "rawSha256", "capturedAtUtc", "ownerAlias"],
        "properties": {
          "id": { "type": "string", "pattern": "^EVD-E8-(?:0[1-9]|[1-3][0-9]|4[0-8])$" },
          "status": {
            "enum": [
              "NOT_STARTED",
              "VERIFIED_FULL",
              "PARTIAL_RISK",
              "NOT_VERIFIED",
              "FAILED",
              "BLOCKED_EXTERNAL",
              "NOT_APPLICABLE_APPROVED",
              "DISQUALIFIER"
            ]
          },
          "sourcePath": {
            "oneOf": [{ "$ref": "#/$defs/evidencePath" }, { "type": "null" }]
          },
          "rawSha256": {
            "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
          },
          "capturedAtUtc": {
            "oneOf": [{ "$ref": "#/$defs/utc" }, { "type": "null" }]
          },
          "ownerAlias": {
            "oneOf": [{ "$ref": "#/$defs/alias" }, { "type": "null" }]
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidenceIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^ACC-TC-(?:0[1-9]|[12][0-9]|3[0-2])$" },
          "result": { "enum": ["NOT_EVALUATED", "PASS", "FAIL", "BLOCKED_EXTERNAL"] },
          "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
        }
      }
    },
    "auditControls": {
      "type": "array",
      "minItems": 72,
      "maxItems": 72,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidenceIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^ACCAUD-(?:0[1-9]|[1-6][0-9]|7[0-2])$" },
          "result": {
            "enum": [
              "NOT_EVALUATED",
              "PASS",
              "FAIL",
              "BLOCKED_EXTERNAL",
              "REVIEW_REQUIRED",
              "NOT_APPLICABLE_APPROVED"
            ]
          },
          "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["GATE-E8-01", "GATE-E8-02", "GATE-E8-03"],
      "properties": {
        "GATE-E8-01": { "enum": ["NOT_EVALUATED", "PASS", "FAIL"] },
        "GATE-E8-02": { "$ref": "#/$defs/gateStatus" },
        "GATE-E8-03": { "$ref": "#/$defs/gateStatus" }
      }
    },
    "scorecard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseVerifiedPoints",
        "baseTotalPoints",
        "bonusVerifiedPoints",
        "bonusTotalPoints",
        "highConfidenceBaseRubrics",
        "signed"
      ],
      "properties": {
        "baseVerifiedPoints": { "type": "integer", "minimum": 0, "maximum": 100 },
        "baseTotalPoints": { "const": 100 },
        "bonusVerifiedPoints": { "type": "integer", "minimum": 0, "maximum": 50 },
        "bonusTotalPoints": { "const": 50 },
        "highConfidenceBaseRubrics": { "type": "integer", "minimum": 0, "maximum": 6 },
        "signed": { "type": "boolean" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openP0",
        "openP1",
        "openP2",
        "acceptedP2",
        "disqualifiers",
        "openCriticalRisks"
      ],
      "properties": {
        "openP0": { "$ref": "#/$defs/nonNegativeInteger" },
        "openP1": { "$ref": "#/$defs/nonNegativeInteger" },
        "openP2": { "$ref": "#/$defs/nonNegativeInteger" },
        "acceptedP2": { "$ref": "#/$defs/nonNegativeInteger" },
        "disqualifiers": { "$ref": "#/$defs/nonNegativeInteger" },
        "openCriticalRisks": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rehearsal", "contingency"],
      "properties": {
        "rehearsal": { "enum": ["NOT_STARTED", "PASS", "FAIL", "BLOCKED_EXTERNAL"] },
        "contingency": { "enum": ["NOT_STARTED", "READY", "FAIL"] }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "artifacts", "evidence", "cases", "auditControls"],
      "properties": {
        "complete": { "type": "boolean" },
        "artifacts": { "$ref": "#/$defs/nonNegativeInteger" },
        "evidence": { "$ref": "#/$defs/nonNegativeInteger" },
        "cases": { "$ref": "#/$defs/nonNegativeInteger" },
        "auditControls": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "decision": {
      "enum": ["PENDING", "ACCEPTED", "REJECTED", "RETURN_TO_STAGE", "REVIEW_REQUIRED"]
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "alias", "signedAtUtc"],
        "properties": {
          "role": { "enum": ["ACCEPTANCE_LEAD", "OBSERVER"] },
          "alias": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$" },
          "signedAtUtc": { "$ref": "#/$defs/utc" }
        }
      }
    },
    "handoffReady": { "type": "boolean" },
    "containsSensitiveData": { "const": false },
    "assessmentSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "alias": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$" },
    "evidencePath": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "allOf": [
        { "not": { "pattern": "^stage8-finalization/" } },
        { "not": { "pattern": "//" } },
        { "not": { "pattern": "(?:^|/)\\.{1,2}(?:/|$)" } }
      ]
    },
    "evidenceIds": {
      "type": "array",
      "maxItems": 48,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EVD-E8-(?:0[1-9]|[1-3][0-9]|4[0-8])$"
      }
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "runtimeSha", "submissionSha", "tag", "documentationCommit"],
      "properties": {
        "releaseId": {
          "type": "string",
          "pattern": "^rel-[0-9]{8}-[0-9]{4}-[0-9a-f]{7}$"
        },
        "runtimeSha": { "$ref": "#/$defs/sha" },
        "submissionSha": { "$ref": "#/$defs/sha" },
        "documentationCommit": { "$ref": "#/$defs/documentationCommit" },
        "tag": {
          "type": "string",
          "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-rc\\.[1-9][0-9]*)?$"
        }
      }
    },
    "documentationCommit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "authority"],
          "properties": { "mode": { "const": "SAME_COMMIT" }, "authority": { "type": "null" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "authority"],
          "properties": {
            "mode": { "const": "DOCUMENTATION_ONLY_APPROVED" },
            "authority": { "$ref": "#/$defs/documentationAuthority" }
          }
        }
      ]
    },
    "documentationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "stage",
        "kind",
        "status",
        "fromSha",
        "toSha",
        "changedPaths",
        "ownerAlias",
        "approvedByAlias",
        "approvedAtUtc",
        "reason",
        "sourceHashes",
        "containsSensitiveData",
        "authoritySha256",
        "authorityRawSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "stage": { "const": 8 },
        "kind": { "const": "STAGE8_DOCUMENTATION_COMMIT_AUTHORITY" },
        "status": { "const": "APPROVED" },
        "fromSha": { "$ref": "#/$defs/sha" },
        "toSha": { "$ref": "#/$defs/sha" },
        "changedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:README\\.md|docs/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+\\.md)$"
          }
        },
        "ownerAlias": { "$ref": "#/$defs/alias" },
        "approvedByAlias": { "$ref": "#/$defs/alias" },
        "approvedAtUtc": { "$ref": "#/$defs/utc" },
        "reason": { "type": "string", "minLength": 12, "maxLength": 500 },
        "sourceHashes": { "$ref": "#/$defs/documentationSourceHashes" },
        "containsSensitiveData": { "const": false },
        "authoritySha256": { "$ref": "#/$defs/sha256" },
        "authorityRawSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "documentationSourceHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitMetadataRawSha256",
        "changedPathsRawSha256",
        "approvalRawSha256",
        "updatedManifestRawSha256"
      ],
      "properties": {
        "commitMetadataRawSha256": { "$ref": "#/$defs/sha256" },
        "changedPathsRawSha256": { "$ref": "#/$defs/sha256" },
        "approvalRawSha256": { "$ref": "#/$defs/sha256" },
        "updatedManifestRawSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "gateStatus": { "enum": ["NOT_EVALUATED", "PASS", "FAIL", "BLOCKED_EXTERNAL"] },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 }
  }
}

# Local-only, non-secret configuration. Values cannot authorize a real provider.
APP_ENV=local
API_PORT=3000
API_BASE_PATH=/api/v1
ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATA_ADAPTER=memory
DYNAMODB_ENDPOINT=http://localhost:8000
CATALOG_TABLE_NAME=checkout-catalog-local
CHECKOUT_TABLE_NAME=checkout-session-local
# Para DATA_ADAPTER=dynamodb, inyecta RUNTIME_SECURITY_ROOT_KEY fuera de Git.
# Formato: base64url canónico sin padding, de 32 a 96 bytes.
RUNTIME_SECURITY_ROOT_KEY=
PRODUCT_SEED_ID=product-demo-001
PRODUCT_INITIAL_STOCK=3
CHECKOUT_TTL_SECONDS=1800
PAYMENT_ADAPTER=fake
PAYMENTS_ENABLED=false
PRERELEASE_ACCESS_MODE=disabled
TOKENIZATION_MODE=disabled
FAKE_PAYMENT_SCENARIO=FAKE-E5-01
FAKE_RECONCILE_INTERVAL_MS=100
QUOTE_TTL_SECONDS=900
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_PRODUCT_ID=product-demo-001

# Variables no secretas de GitHub para Etapas 6 y 7. Los tres payloads B64 son
# configuraciones canónicas, no credenciales; se generan con `pnpm stage7:config:author`.
# Full y baseline comparten región/roles. Prerelease usa otra región y roles propios.
STAGE7_AWS_ACCOUNT_ID=
STAGE7_AWS_REGION=us-east-1
STAGE7_CONFIG_B64=
STAGE7_BASELINE_CONFIG_B64=
STAGE7_AWS_READ_ROLE_ARN=
STAGE7_AWS_DEPLOY_ROLE_ARN=
STAGE7_AWS_ROLLBACK_ROLE_ARN=
STAGE7_AWS_CLEANUP_ROLE_ARN=
STAGE7_AWS_BASELINE_ROLE_ARN=
STAGE7_PRERELEASE_AWS_REGION=
STAGE7_PRERELEASE_CONFIG_B64=
STAGE7_PRERELEASE_AWS_READ_ROLE_ARN=
STAGE7_PRERELEASE_AWS_DEPLOY_ROLE_ARN=
STAGE7_PRERELEASE_AWS_ROLLBACK_ROLE_ARN=
STAGE7_PRERELEASE_AWS_CLEANUP_ROLE_ARN=
STAGE7_PRERELEASE_CLEANUP_WATCHDOG_ROLE_ARN=

# Entradas no secretas para sintetizar los dos CDKToolkit regionales. El primer
# provisionamiento se hace con credenciales temporales de un operador AWS; estos
# valores no autorizan por sí solos ningún despliegue desde GitHub.
STAGE7_CANDIDATE_SHA=
STAGE7_AWS_COUNTERPART_REGION=
STAGE7_PRERELEASE_ENVIRONMENT=
# El nombre de la variable es contractual: el ARN apunta al runtime JSON secret
# completo (root, origin y Sandbox), no a un valor de token aislado.
STAGE7_ORIGIN_TOKEN_SECRET_ARN=
STAGE7_CREDENTIAL_REFERENCES_JSON=[]
STAGE7_HOSTED_ZONE_ID=
STAGE7_WEB_HOSTNAME=
STAGE7_API_HOSTNAME=
STAGE7_WEB_CERTIFICATE_ARN=
STAGE7_API_CERTIFICATE_ARN=
STAGE7_BOOTSTRAP_SCOPE=
STAGE7_INCLUDE_AUXILIARY_READ_AUTHORITY=false

# Autoridades IAM auxiliares. Son ARN públicos de roles/boundaries; no conceden
# acceso sin el token OIDC de un GitHub Environment protegido.
STAGE7_RELEASE_JOURNAL_CLEANUP_ROLE_ARN=
STAGE7_RELEASE_JOURNAL_CLEANUP_PERMISSIONS_BOUNDARY_ARN=
STAGE7_RELEASE_RECONCILIATION_RECOVERY_ROLE_ARN=
STAGE7_RELEASE_RECONCILIATION_RECOVERY_PERMISSIONS_BOUNDARY_ARN=

# Outputs synth-only del stack aislado de recuperación de publicación del sucesor.
# Estas variables protegidas enlazan el workflow con el único rol /checkout/ permitido
# y su boundary BASE idéntica; la policy de sesión dinámica nunca se provisiona aquí.
STAGE7_RELEASE_SUCCESSOR_PUBLICATION_RECOVERY_ROLE_ARN=
STAGE7_RELEASE_SUCCESSOR_PUBLICATION_RECOVERY_PERMISSIONS_BOUNDARY_ARN=

# Evidencias/autorizaciones temporales: se cargan como GitHub Variables sólo para
# el SHA y la ventana aprobados. Nunca reutilices estos valores entre scopes/runs.
STAGE6_A11Y_MANUAL_EVIDENCE_B64=
STAGE6_EXTERNAL_EVIDENCE_B64=
STAGE6_SANDBOX_AUTHORIZATION_B64=
STAGE7_EXTERNAL_AUTHORIZATIONS_B64=
STAGE7_RELEASE_SUCCESSOR_PUBLICATION_RECOVERY_AUTHORITY_B64=

# Nombres de GitHub Secrets requeridos (deja estos valores vacíos en archivos).
# Configura los valores reales exclusivamente dentro del GitHub Environment indicado.
# Cada *_SIGNED_COOKIE_B64 usa una sola capa base64 del JSON de cuatro cookies RSA-SHA256.
# No decodifiques ni vuelvas a codificar el valor entre prerelease y baseline.
STAGE7_ALERT_EMAIL=
STAGE7_CLOUDFRONT_SIGNED_COOKIE_B64=
STAGE7_CLOUDFRONT_EXPIRED_SIGNED_COOKIE_B64=
STAGE7_BASELINE_SIGNED_COOKIE_B64=
STAGE7_BASELINE_EXPIRED_SIGNED_COOKIE_B64=
STAGE7_SMOKE_INPUTS_B64=
STAGE6_SANDBOX_PUBLIC_KEY=
STAGE6_SANDBOX_PRIVATE_KEY=
STAGE6_SANDBOX_INTEGRITY_SECRET=
STAGE6_SANDBOX_CARD_NUMBER=
STAGE6_SANDBOX_CARD_EXPIRY=
STAGE6_SANDBOX_CARD_CVC=
STAGE6_SANDBOX_CARD_HOLDER=
STAGE6_SANDBOX_CUSTOMER_EMAIL=

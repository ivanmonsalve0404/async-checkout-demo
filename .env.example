# Local-only, non-secret configuration. Values cannot authorize a real provider.
APP_ENV=local
API_PORT=3000
API_BASE_PATH=/api/v1
ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATA_ADAPTER=memory
DYNAMODB_ENDPOINT=http://localhost:8000
CATALOG_TABLE_NAME=checkout-catalog-local
CHECKOUT_TABLE_NAME=checkout-session-local
# Para DATA_ADAPTER=dynamodb, inyecta RUNTIME_SECURITY_ROOT_KEY fuera de Git.
# Formato: base64url canónico sin padding, de 32 a 96 bytes.
RUNTIME_SECURITY_ROOT_KEY=
PRODUCT_SEED_ID=product-demo-001
PRODUCT_INITIAL_STOCK=3
CHECKOUT_TTL_SECONDS=1800
PAYMENT_ADAPTER=fake
PAYMENTS_ENABLED=false
PRERELEASE_ACCESS_MODE=disabled
TOKENIZATION_MODE=disabled
FAKE_PAYMENT_SCENARIO=FAKE-E5-01
FAKE_RECONCILE_INTERVAL_MS=100
QUOTE_TTL_SECONDS=900
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_PRODUCT_ID=product-demo-001

# Variables protegidas de GitHub para la autoridad durable de reconciliación de Etapa 7.
# Son identificadores no secretos; no conceden acceso sin la sesión OIDC protegida.
# El rol debe usar únicamente política inline y el permissions boundary exacto (sin
# managed policies adjuntas). Configúralas como Repository/Environment variables.
# `infra/bin/authority.ts` sólo sintetiza la plantilla: provisionarla requiere una
# autorización externa y sus cuatro outputs deben poblar las variables de roles/boundaries.
STAGE7_AWS_ACCOUNT_ID=
STAGE7_AWS_REGION=us-east-1
STAGE7_AWS_READ_ROLE_ARN=
STAGE7_RELEASE_JOURNAL_CLEANUP_ROLE_ARN=
STAGE7_RELEASE_JOURNAL_CLEANUP_PERMISSIONS_BOUNDARY_ARN=
STAGE7_RELEASE_RECONCILIATION_RECOVERY_ROLE_ARN=
STAGE7_RELEASE_RECONCILIATION_RECOVERY_PERMISSIONS_BOUNDARY_ARN=

# Outputs synth-only del stack aislado de recuperación de publicación del sucesor.
# Estas variables protegidas enlazan el workflow con el único rol /checkout/ permitido
# y su boundary BASE idéntica; la policy de sesión dinámica nunca se provisiona aquí.
STAGE7_RELEASE_SUCCESSOR_PUBLICATION_RECOVERY_ROLE_ARN=
STAGE7_RELEASE_SUCCESSOR_PUBLICATION_RECOVERY_PERMISSIONS_BOUNDARY_ARN=

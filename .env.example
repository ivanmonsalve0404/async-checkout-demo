# Local-only, non-secret configuration. Values cannot authorize a real provider.
APP_ENV=local
API_PORT=3000
API_BASE_PATH=/api/v1
ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATA_ADAPTER=memory
DYNAMODB_ENDPOINT=http://localhost:8000
CATALOG_TABLE_NAME=checkout-catalog-local
CHECKOUT_TABLE_NAME=checkout-session-local
# Para DATA_ADAPTER=dynamodb, inyecta RUNTIME_SECURITY_ROOT_KEY fuera de Git.
# Formato: base64url canónico sin padding, de 32 a 96 bytes.
RUNTIME_SECURITY_ROOT_KEY=
PRODUCT_SEED_ID=product-demo-001
PRODUCT_INITIAL_STOCK=3
CHECKOUT_TTL_SECONDS=1800
PAYMENT_ADAPTER=fake
PAYMENTS_ENABLED=false
TOKENIZATION_MODE=disabled
FAKE_PAYMENT_SCENARIO=FAKE-E5-01
FAKE_RECONCILE_INTERVAL_MS=100
QUOTE_TTL_SECONDS=900
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_PRODUCT_ID=product-demo-001
